<Window x:Class="AetherForge.App.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/Icons/AetherForge.ico"
        Width="1200"
        Height="950"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="{DynamicResource PanelBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BronzeLightBrush}">

            <TabItem x:Name="InformationTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Image Source="Assets/Logos/aetherforge_logo.png"
                               Width="380"
                               Height="120"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18"/>

                        <TextBlock Text="AetherForge Converter"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="VersionTextBlock"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <StackPanel Margin="0,0,0,24">

                            <TextBlock TextWrapping="Wrap"
                                    FontSize="15"
                                    LineHeight="24"
                                    Margin="0,0,0,20">
                                <Run Text="AetherForge" FontWeight="SemiBold"/>
                                <Run x:Name="AboutIntroductionRun"/>
                            </TextBlock>

                            <TextBlock x:Name="AboutFeaturesHeading"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,14"/>

                            <TextBlock TextWrapping="Wrap"
                                    FontSize="14"
                                    LineHeight="23"
                                    Margin="0,0,0,10">
                                <Run Text="• "/>
                                <Run x:Name="AboutConversionHeadingRun"
                                    FontWeight="SemiBold"/>
                                <Run x:Name="AboutConversionBodyRun"/>
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap"
                                    FontSize="14"
                                    LineHeight="23"
                                    Margin="0,0,0,10">
                                <Run Text="• "/>
                                <Run x:Name="AboutEditingHeadingRun"
                                    FontWeight="SemiBold"/>
                                <Run x:Name="AboutEditingBodyRun"/>
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap"
                                    FontSize="14"
                                    LineHeight="23"
                                    Margin="0,0,0,10">
                                <Run Text="• "/>
                                <Run x:Name="AboutPdfHeadingRun"
                                    FontWeight="SemiBold"/>
                                <Run x:Name="AboutPdfBodyRun"/>
                            </TextBlock>

                            <TextBlock TextWrapping="Wrap"
                                    FontSize="14"
                                    LineHeight="23"
                                    Margin="0,0,0,20">
                                <Run Text="• "/>
                                <Run x:Name="AboutPrivacyHeadingRun"
                                    FontWeight="SemiBold"/>
                                <Run x:Name="AboutPrivacyBodyRun"/>
                            </TextBlock>

                            <TextBlock x:Name="AboutFooterTextBlock"
                                    TextWrapping="Wrap"
                                    FontSize="14"
                                    LineHeight="23"/>

                        </StackPanel>

<Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,20,0">

        <Button x:Name="RepositoryButton"
                Padding="14,8"
                Margin="0,0,12,0"
                Cursor="Hand"
                Click="RepositoryButton_Click"/>

        <Button x:Name="WebsiteButton"
                Padding="14,8"
                Cursor="Hand"
                Click="WebsiteButton_Click">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/Logos/flamesworn_icon.png"
                       Width="24"
                       Height="24"
                       Stretch="Uniform"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"/>
                <TextBlock x:Name="WebsiteButtonText"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>

    <Button x:Name="SupportButton"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Padding="14,8"
            Cursor="Hand"
            Click="SupportButton_Click">

        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/Logos/kofi_cup.png"
                   Width="28"
                   Height="24"
                   Stretch="Uniform"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"/>

            <TextBlock x:Name="SupportButtonText"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</Grid>
                        <Separator Margin="0,18,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AutomaticUpdatesCheckBox"
                                      VerticalAlignment="Center"
                                      Margin="0,0,18,0"
                                      Click="AutomaticUpdatesCheckBox_Click"/>
                            <Button x:Name="CheckUpdatesButton"
                                    Grid.Column="1"
                                    Padding="14,8"
                                    Cursor="Hand"
                                    Click="CheckUpdatesButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="UpdateConnectionTextBlock"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LicensesTab">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LicensesExplanationTextBlock"
                               Grid.ColumnSpan="2"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <ListBox x:Name="ComponentsListBox"
                             Grid.Row="1"
                             DisplayMemberPath="Name"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BronzeLightBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ComponentsListBox_SelectionChanged"/>

                    <TextBox x:Name="LicenseTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="14,0,0,0"
                             Padding="12"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BronzeLightBrush}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas"
                             FontSize="12"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="AppLicenseTab">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AetherForge — MIT License"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="Copyright © 2026 Matteo Ferranti"
                   FontSize="15"
                   Margin="0,0,0,18"/>

        <TextBlock x:Name="AppLicenseExplanationTextBlock"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   FontSize="14"
                   LineHeight="23"
                   Margin="0,0,0,18"/>

        <TextBox x:Name="AppLicenseTextBox"
                 Grid.Row="3"
                 Padding="14"
                 Background="{DynamicResource BackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BronzeLightBrush}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas"
                 FontSize="13"/>
    </Grid>
</TabItem>
        </TabControl>

        <Button x:Name="CloseButton"
                Grid.Row="1"
                HorizontalAlignment="Right"
                MinWidth="100"
                Padding="14,8"
                Margin="0,18,0,0"
                IsCancel="True"/>
    </Grid>
</Window>
