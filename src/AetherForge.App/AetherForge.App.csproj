<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**\*" />
    <Resource Include="Assets\Logos\**\*" />
    <Resource Include="Assets\Flags\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64"
                      Version="14.17.1" />
  </ItemGroup>

  <Target Name="CopyFFmpegTools"
          AfterTargets="Build">

    <MakeDir Directories="$(OutDir)Tools\FFmpeg" />

    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffmpeg.exe;$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffprobe.exe"
      DestinationFolder="$(OutDir)Tools\FFmpeg"
      SkipUnchangedFiles="true" />

  </Target>

  <Target Name="CopyFFmpegToolsToPublish"
          AfterTargets="Publish">

    <MakeDir Directories="$(PublishDir)Tools\FFmpeg" />

    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffmpeg.exe;$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffprobe.exe"
      DestinationFolder="$(PublishDir)Tools\FFmpeg"
      SkipUnchangedFiles="true" />

  </Target>

</Project>