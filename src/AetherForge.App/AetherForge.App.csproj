<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Icons\AetherForge.ico</ApplicationIcon>

  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**\*" />
    <Resource Include="Assets\Logos\**\*" />
    <Resource Include="Assets\Flags\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

  <Target Name="CopyFFmpegTools" AfterTargets="Build">

    <MakeDir Directories="$(OutDir)Tools\FFmpeg" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffmpeg.exe;$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffprobe.exe" DestinationFolder="$(OutDir)Tools\FFmpeg" SkipUnchangedFiles="true" />

  </Target>

  <Target Name="CopyFFmpegToolsToPublish" AfterTargets="Publish">

    <MakeDir Directories="$(PublishDir)Tools\FFmpeg" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffmpeg.exe;$(MSBuildProjectDirectory)\..\..\tools\ffmpeg\ffprobe.exe" DestinationFolder="$(PublishDir)Tools\FFmpeg" SkipUnchangedFiles="true" />

  </Target>

  <ItemGroup>
  <None Update="Assets\Fonts\NotoSans-Regular.ttf">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>

  <None Update="Assets\Fonts\NotoSans-LICENSE.txt">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

<ItemGroup>
  <None Include="..\..\tools\libreoffice\**\*"
        Exclude="..\..\tools\libreoffice\**\*.msi">

    <Link>Tools\LibreOffice\%(RecursiveDir)%(Filename)%(Extension)</Link>

    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

<ItemGroup>
  <None Include="..\..\tools\qpdf\**\*">
    <Link>Tools\QPDF\%(RecursiveDir)%(Filename)%(Extension)</Link>
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

<ItemGroup>
  <None Update="Assets\Licenses\**\*.txt">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

<ItemGroup>
  <None Include="..\..\LICENSE">
    <Link>Assets\Licenses\AetherForge-LICENSE.txt</Link>
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

</Project>