<Window x:Class="AetherForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AetherForge.App.Models"
        Title="AetherForge Converter"
        Icon="Assets/Icons/AetherForge.ico"
        Width="1400"
        Height="850"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

  <Grid Margin="32">

    <Grid.RowDefinitions>
        <RowDefinition Height="220"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Selettore lingua -->
 <StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Panel.ZIndex="10">

    <Button
        x:Name="EnglishButton"
        Width="84"
        Height="40"
        Margin="0,0,10,0"
        Padding="8,4"
        Click="EnglishButton_Click"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource TealBrush}"
        BorderThickness="2"
        Cursor="Hand">

        <StackPanel Orientation="Horizontal">
            <Image
                Source="Assets/Flags/en.png"
                Width="36"
                Height="22"
                Stretch="Uniform"
                Margin="0,0,8,0"/>

            <TextBlock
                Text="EN"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

    </Button>

    <Button
        x:Name="ItalianButton"
        Width="84"
        Height="40"
        Padding="8,4"
        Click="ItalianButton_Click"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BronzeLightBrush}"
        BorderThickness="1"
        Cursor="Hand">

        <StackPanel Orientation="Horizontal">
            <Image
                Source="Assets/Flags/it.png"
                Width="36"
                Height="22"
                Stretch="Uniform"
                Margin="0,0,8,0"/>

            <TextBlock
                Text="IT"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

    </Button>

</StackPanel>

<!-- Informazioni e licenze -->
<Button x:Name="AboutButton"
        Grid.Row="0"
        Width="40"
        Height="40"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Panel.ZIndex="10"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        BorderBrush="{StaticResource BronzeLightBrush}"
        BorderThickness="1"
        Cursor="Hand"
        Click="AboutButton_Click">

    <TextBlock Text="ⓘ"
               FontFamily="Segoe UI Symbol"
               FontSize="24"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
</Button>

        <!-- Logo -->
        <Image
            Grid.Row="0"
            Source="Assets/Logos/aetherforge_logo.png"
            Width="650"
            Height="200"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Area principale -->
        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            CornerRadius="18"
            Background="{StaticResource PanelAltBrush}"
            BorderBrush="{StaticResource BronzeLightBrush}"
            BorderThickness="2"
            Padding="28">

          <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock
        x:Name="DragFilesTextBlock"
        Grid.Row="0"
        HorizontalAlignment="Center"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{StaticResource TextPrimaryBrush}"/>

    <TextBlock
        x:Name="OrTextBlock"
        Grid.Row="1"
        Margin="0,10,0,10"
        HorizontalAlignment="Center"
        FontSize="16"
        Foreground="{StaticResource TextSecondaryBrush}"/>

<StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

    <Button x:Name="SelectFilesButton"
            Width="180"
            Height="42"
            Margin="0,0,12,0"
            Click="SelectFilesButton_Click"
            Background="{StaticResource TealBrush}"
            Foreground="White"
            BorderThickness="0"
            FontSize="16"
            FontWeight="SemiBold"
            Cursor="Hand"/>

    <Button x:Name="MergePdfsButton"
            Width="180"
            Height="42"
            Click="MergePdfsButton_Click"
            Background="{StaticResource TealBrush}"
            Foreground="White"
            BorderThickness="0"
            FontSize="16"
            FontWeight="SemiBold"
            Cursor="Hand"/>

</StackPanel>

    <DataGrid
        x:Name="FilesDataGrid"
        Grid.Row="3"
        Margin="0,24,0,0"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        IsReadOnly="True"
        SelectionMode="Extended"
        Background="Transparent"
        BorderThickness="0"
        GridLinesVisibility="Horizontal"
        HorizontalGridLinesBrush="{StaticResource BronzeLightBrush}"
        RowHeaderWidth="0"
        FontSize="15"
        Foreground="{StaticResource TextPrimaryBrush}">

<DataGrid.Columns>

<DataGridTemplateColumn x:Name="NameColumn"
                        Width="*">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           ToolTip="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Status}"
                                    Value="{x:Static models:ConversionStatus.Completed}">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Width="26"
                            Height="26"
                            Margin="0,0,4,0"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{DynamicResource OpenOutputTooltip}"
                            AutomationProperties.Name="{DynamicResource OpenOutputTooltip}"
                            Click="OpenRowOutputButton_Click">

                        <Path Data="M 5,3 H 13 L 19,9 V 21 H 5 Z M 13,3 V 9 H 19"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"/>

                    </Button>

                    <Button Width="26"
                            Height="26"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="{DynamicResource ShowOutputFolderTooltip}"
                            AutomationProperties.Name="{DynamicResource ShowOutputFolderTooltip}"
                            Click="ShowRowOutputFolderButton_Click">

                        <Path Data="M 2,6 H 9 L 11,9 H 22 V 20 H 2 Z"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.5"
                              Stretch="Uniform"/>

                    </Button>

                </StackPanel>
            </Grid>

        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>

    <DataGridTextColumn
         x:Name="CategoryColumn"
         Binding="{Binding Category}"
         Width="110"/>

     <DataGridTextColumn
         x:Name="InputColumn"
         Binding="{Binding Format}"
         Width="80"/>

         <DataGridTemplateColumn
    x:Name="OperationColumn"
    Width="150">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <ComboBox
                ItemsSource="{Binding AvailableOperations}"
                SelectedItem="{Binding SelectedOperation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectionChanged="OperationComboBox_SelectionChanged"
                Height="28"
                VerticalContentAlignment="Center"/>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>


<DataGridTemplateColumn
    x:Name="ResizeWidthColumn"
    Width="90">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBox
                Text="{Binding ResizeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center"
                PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput"
                DataObject.Pasting="PositiveIntegerTextBox_Pasting">

                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedOperation.Operation}"
                                Value="{x:Static models:ConversionOperation.Resize}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>

<DataGridTemplateColumn
    x:Name="ResizeHeightColumn"
    Width="90">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBox
                Text="{Binding ResizeHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center"
                PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput"
                DataObject.Pasting="PositiveIntegerTextBox_Pasting">

                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedOperation.Operation}"
                                Value="{x:Static models:ConversionOperation.Resize}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>


<DataGridTemplateColumn
    x:Name="QualityColumn"
    Width="95">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBox
                Text="{Binding QualityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center"
                PreviewTextInput="PercentageTextBox_PreviewTextInput"
                DataObject.Pasting="PercentageTextBox_Pasting">

                <TextBox.Style>
                    <Style TargetType="TextBox">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedOperation.Operation}"
                                Value="{x:Static models:ConversionOperation.ChangeQuality}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBox.Style>

            </TextBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>


<DataGridTemplateColumn
    x:Name="AudioBitrateColumn"
    Width="120">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <ComboBox
                ItemsSource="{Binding AvailableAudioBitrates}"
                SelectedItem="{Binding AudioBitrateKbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center">

                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition
                                        Binding="{Binding Category}"
                                        Value="Audio"/>

                                    <Condition
                                        Binding="{Binding SelectedOperation.Operation}"
                                        Value="{x:Static models:ConversionOperation.ChangeQuality}"/>
                                </MultiDataTrigger.Conditions>

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>

            </ComboBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>


     <DataGridTemplateColumn
         x:Name="OutputColumn"
         Width="120">

        <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>

                <ComboBox
                    ItemsSource="{Binding AvailableOutputFormats}"
                    SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Height="28"
                    VerticalContentAlignment="Center"/>

            </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>

    </DataGridTemplateColumn>

    <DataGridTextColumn
         x:Name="SizeColumn"
         Binding="{Binding Size}"
         Width="120"/>

    <DataGridTextColumn
        x:Name="StatusColumn"
        Binding="{Binding StatusText}"
        Width="120"/>

</DataGrid.Columns>

    </DataGrid>

<!-- Barra comandi -->

<Grid Grid.Row="4"
      Margin="0,20,0,0">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <WrapPanel Grid.Column="0"
               VerticalAlignment="Center">

        <Button x:Name="RemoveSelectedButton"
                Padding="14,8"
                Margin="0,0,10,8"
                Click="RemoveSelectedButton_Click"
                Cursor="Hand"/>

        <Button x:Name="ClearListButton"
                Padding="14,8"
                Margin="0,0,10,8"
                Click="ClearListButton_Click"
                Cursor="Hand"/>


    </WrapPanel>

    <Button x:Name="ConvertButton"
            Grid.Column="1"
            VerticalAlignment="Center"
            Margin="14,0,0,8"
            Padding="18,8"
            Click="ConvertButton_Click"
            Background="{StaticResource BronzeBrush}"
            Foreground="White"
            BorderThickness="0"
            FontWeight="SemiBold"
            Cursor="Hand"/>

</Grid>

</Grid>

        </Border>

        <TextBlock
            x:Name="FooterTextBlock"
            Grid.Row="2"
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{StaticResource TextSecondaryBrush}"
            Opacity="0.8"
            Text="v 1.0.0 | Made by the Messere"/>

    </Grid>

</Window>