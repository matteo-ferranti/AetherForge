<Window x:Class="AetherForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherForge Converter"
        Icon="Assets/Icons/AetherForge.ico"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Image
            Grid.Row="0"
            Source="Assets/Logos/aetherforge_logo.png"
            Width="650"
            Height="200"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Area principale -->
        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            CornerRadius="18"
            Background="{StaticResource PanelAltBrush}"
            BorderBrush="{StaticResource BronzeLightBrush}"
            BorderThickness="2"
            Padding="28">

          <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock
        Grid.Row="0"
        Text="Trascina qui i tuoi file"
        HorizontalAlignment="Center"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{StaticResource TextPrimaryBrush}"/>

    <TextBlock
        Grid.Row="1"
        Text="oppure"
        Margin="0,10,0,10"
        HorizontalAlignment="Center"
        FontSize="16"
        Foreground="{StaticResource TextSecondaryBrush}"/>

    <Button
        Grid.Row="2"
        Content="Seleziona file"
        Width="180"
        Height="42"
        HorizontalAlignment="Center"
        Click="SelectFilesButton_Click"
        Background="{StaticResource TealBrush}"
        Foreground="White"
        BorderThickness="0"
        FontSize="16"
        FontWeight="SemiBold"
        Cursor="Hand"/>

    <DataGrid
        x:Name="FilesDataGrid"
        Grid.Row="3"
        Margin="0,24,0,0"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        IsReadOnly="True"
        SelectionMode="Extended"
        Background="Transparent"
        BorderThickness="0"
        GridLinesVisibility="Horizontal"
        HorizontalGridLinesBrush="{StaticResource BronzeLightBrush}"
        RowHeaderWidth="0"
        FontSize="15"
        Foreground="{StaticResource TextPrimaryBrush}">

        <DataGrid.Columns>

            <DataGridTextColumn
                Header="Nome"
                Binding="{Binding Name}"
                Width="*"/>

            <DataGridTextColumn
                Header="Categoria"
                Binding="{Binding Category}"
                Width="140"/>

            <DataGridTextColumn
                Header="Formato"
                Binding="{Binding Format}"
                Width="110"/>

            <DataGridTextColumn
                Header="Dimensione"
                Binding="{Binding Size}"
                Width="130"/>

        </DataGrid.Columns>

    </DataGrid>

    <!-- Barra comandi -->
    <Grid
        Grid.Row="4"
        Margin="0,20,0,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button
            Grid.Column="0"
            Content="Rimuovi selezionati"
            Padding="14,8"
            Margin="0,0,10,0"
            Click="RemoveSelectedButton_Click"
            Cursor="Hand"/>

        <Button
            Grid.Column="1"
            Content="Svuota lista"
            Padding="14,8"
            Click="ClearListButton_Click"
            Cursor="Hand"/>

        <TextBlock
            Grid.Column="3"
            Text="Formato output:"
            VerticalAlignment="Center"
            Margin="0,0,10,0"
            Foreground="{StaticResource TextPrimaryBrush}"/>

        <ComboBox
            x:Name="OutputFormatComboBox"
            Grid.Column="4"
            Height="36"
            VerticalContentAlignment="Center"
            SelectionChanged="OutputFormatComboBox_SelectionChanged"/>

        <Button
            x:Name="ConvertButton"
            Grid.Column="5"
            Content="Converti"
            Margin="14,0,0,0"
            Padding="18,8"
            IsEnabled="False"
            Background="{StaticResource BronzeBrush}"
            Foreground="White"
            BorderThickness="0"
            FontWeight="SemiBold"
            Cursor="Hand"/>

    </Grid>

</Grid>

        </Border>

    </Grid>

</Window>