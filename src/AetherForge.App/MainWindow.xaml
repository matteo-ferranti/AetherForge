<Window x:Class="AetherForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AetherForge.App.Models"
        Title="AetherForge Converter"
        Icon="Assets/Icons/AetherForge.ico"
        Width="1400"
        Height="850"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

  <Grid Margin="32">

    <Grid.RowDefinitions>
        <RowDefinition Height="220"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Selettore lingua -->
 <StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Panel.ZIndex="10">

    <Button
        x:Name="EnglishButton"
        Width="84"
        Height="40"
        Margin="0,0,10,0"
        Padding="8,4"
        Click="EnglishButton_Click"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource TealBrush}"
        BorderThickness="2"
        Cursor="Hand">

        <StackPanel Orientation="Horizontal">
            <Image
                Source="Assets/Flags/en.png"
                Width="36"
                Height="22"
                Stretch="Uniform"
                Margin="0,0,8,0"/>

            <TextBlock
                Text="EN"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

    </Button>

    <Button
        x:Name="ItalianButton"
        Width="84"
        Height="40"
        Padding="8,4"
        Click="ItalianButton_Click"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BronzeLightBrush}"
        BorderThickness="1"
        Cursor="Hand">

        <StackPanel Orientation="Horizontal">
            <Image
                Source="Assets/Flags/it.png"
                Width="36"
                Height="22"
                Stretch="Uniform"
                Margin="0,0,8,0"/>

            <TextBlock
                Text="IT"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                FontSize="14"
                Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

    </Button>

</StackPanel>

        <!-- Logo -->
        <Image
            Grid.Row="0"
            Source="Assets/Logos/aetherforge_logo.png"
            Width="650"
            Height="200"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- Area principale -->
        <Border
            Grid.Row="1"
            Margin="0,8,0,0"
            CornerRadius="18"
            Background="{StaticResource PanelAltBrush}"
            BorderBrush="{StaticResource BronzeLightBrush}"
            BorderThickness="2"
            Padding="28">

          <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock
        x:Name="DragFilesTextBlock"
        Grid.Row="0"
        HorizontalAlignment="Center"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{StaticResource TextPrimaryBrush}"/>

    <TextBlock
        x:Name="OrTextBlock"
        Grid.Row="1"
        Margin="0,10,0,10"
        HorizontalAlignment="Center"
        FontSize="16"
        Foreground="{StaticResource TextSecondaryBrush}"/>

    <Button
        x:Name="SelectFilesButton"
        Grid.Row="2"
        Width="180"
        Height="42"
        HorizontalAlignment="Center"
        Click="SelectFilesButton_Click"
        Background="{StaticResource TealBrush}"
        Foreground="White"
        BorderThickness="0"
        FontSize="16"
        FontWeight="SemiBold"
        Cursor="Hand"/>

    <DataGrid
        x:Name="FilesDataGrid"
        Grid.Row="3"
        Margin="0,24,0,0"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        CanUserDeleteRows="False"
        IsReadOnly="True"
        SelectionMode="Extended"
        Background="Transparent"
        BorderThickness="0"
        GridLinesVisibility="Horizontal"
        HorizontalGridLinesBrush="{StaticResource BronzeLightBrush}"
        RowHeaderWidth="0"
        FontSize="15"
        Foreground="{StaticResource TextPrimaryBrush}">

<DataGrid.Columns>

    <DataGridTextColumn
         x:Name="NameColumn"
         Binding="{Binding Name}"
         Width="*"/>

    <DataGridTextColumn
         x:Name="CategoryColumn"
         Binding="{Binding Category}"
         Width="110"/>

     <DataGridTextColumn
         x:Name="InputColumn"
         Binding="{Binding Format}"
         Width="80"/>

         <DataGridTemplateColumn
    x:Name="OperationColumn"
    Width="150">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <ComboBox
                ItemsSource="{Binding AvailableOperations}"
                SelectedItem="{Binding SelectedOperation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectionChanged="OperationComboBox_SelectionChanged"
                Height="28"
                VerticalContentAlignment="Center"/>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>


<DataGridTemplateColumn
    x:Name="ResizeWidthColumn"
    Width="90">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBox
                Text="{Binding ResizeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center"
                PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput"
                DataObject.Pasting="PositiveIntegerTextBox_Pasting">

                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedOperation.Operation}"
                                Value="{x:Static models:ConversionOperation.Resize}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>

<DataGridTemplateColumn
    x:Name="ResizeHeightColumn"
    Width="90">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBox
                Text="{Binding ResizeHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center"
                PreviewTextInput="PositiveIntegerTextBox_PreviewTextInput"
                DataObject.Pasting="PositiveIntegerTextBox_Pasting">

                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedOperation.Operation}"
                                Value="{x:Static models:ConversionOperation.Resize}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>

            </TextBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>


<DataGridTemplateColumn
    x:Name="QualityColumn"
    Width="95">

    <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
            <TextBox
                Text="{Binding QualityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="28"
                VerticalContentAlignment="Center"
                PreviewTextInput="PercentageTextBox_PreviewTextInput"
                DataObject.Pasting="PercentageTextBox_Pasting">

                <TextBox.Style>
                    <Style TargetType="TextBox">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding SelectedOperation.Operation}"
                                Value="{x:Static models:ConversionOperation.ChangeQuality}">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBox.Style>

            </TextBox>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>

</DataGridTemplateColumn>


     <DataGridTemplateColumn
         x:Name="OutputColumn"
         Width="120">

        <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>

                <ComboBox
                    ItemsSource="{Binding AvailableOutputFormats}"
                    SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Height="28"
                    VerticalContentAlignment="Center"/>

            </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>

    </DataGridTemplateColumn>

    <DataGridTextColumn
         x:Name="SizeColumn"
         Binding="{Binding Size}"
         Width="120"/>

    <DataGridTextColumn
        x:Name="StatusColumn"
        Binding="{Binding StatusText}"
        Width="120"/>

</DataGrid.Columns>

    </DataGrid>

    <!-- Barra comandi -->
  <Grid Grid.Row="4"
      Margin="0,20,0,0">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Button
        x:Name="RemoveSelectedButton"
        Grid.Column="0"
        Padding="14,8"
        Margin="0,0,10,0"
        Click="RemoveSelectedButton_Click"
        Cursor="Hand"/>

    <Button
        x:Name="ClearListButton"
        Grid.Column="1"
        Padding="14,8"
        Click="ClearListButton_Click"
        Cursor="Hand"/>

    <Button
        x:Name="ConvertButton"
        Grid.Column="3"
        Margin="14,0,0,0"
        Padding="18,8"
        IsEnabled="False"
        Click="ConvertButton_Click"
        Background="{StaticResource BronzeBrush}"
        Foreground="White"
        BorderThickness="0"
        FontWeight="SemiBold"
        Cursor="Hand"/>

    </Grid>

</Grid>

        </Border>

    </Grid>

</Window>