<Window x:Class="AetherForge.App.MediaTrimDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="20">

        <TextBlock x:Name="FileNameTextBlock"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="DurationTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock x:Name="TimeInfoTextBlock"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock x:Name="StartLabel"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="StartTextBox"
                 Text="0"
                 MinHeight="30"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"/>

        <TextBlock x:Name="EndLabel"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="EndTextBox"
                 MinHeight="30"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorTextBlock"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">

            <Button x:Name="CancelButton"
                    MinWidth="90"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button x:Name="ContinueButton"
                    MinWidth="90"
                    Padding="10,6"
                    IsDefault="True"
                    Click="ContinueButton_Click"/>

        </StackPanel>
    </StackPanel>
</Window>