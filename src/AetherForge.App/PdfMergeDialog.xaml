<Window x:Class="AetherForge.App.PdfMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660"
        Height="450"
        MinWidth="600"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoTextBlock"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <ListBox x:Name="FilesListBox"
                 Grid.Row="1"
                 SelectionMode="Single"
                 SelectionChanged="FilesListBox_SelectionChanged">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"
                               ToolTip="{Binding FullPath}"
                               Padding="4"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <WrapPanel Grid.Row="2"
                   Margin="0,12,0,12">

            <Button x:Name="AddButton"
                    Padding="10,6"
                    Margin="0,0,8,8"
                    Click="AddButton_Click"/>

            <Button x:Name="RemoveButton"
                    Padding="10,6"
                    Margin="0,0,8,8"
                    Click="RemoveButton_Click"/>

            <Button x:Name="MoveUpButton"
                    Padding="10,6"
                    Margin="0,0,8,8"
                    Click="MoveUpButton_Click"/>

            <Button x:Name="MoveDownButton"
                    Padding="10,6"
                    Margin="0,0,0,8"
                    Click="MoveDownButton_Click"/>

        </WrapPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="CancelButton"
                    MinWidth="90"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button x:Name="MergeButton"
                    MinWidth="100"
                    Padding="10,6"
                    IsDefault="True"
                    Click="MergeButton_Click"/>

        </StackPanel>
    </Grid>
</Window>